# Copy to .env. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://tenderiq:tenderiq@localhost:5432/tenderiq
CHECKPOINT_DB_URL=postgresql://tenderiq:tenderiq@localhost:5432/tenderiq
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000

LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
EMBEDDING_PROVIDER=openai      # needed even when LLM_PROVIDER=anthropic
EMBEDDING_MODEL=               # must return 1536-dim vectors
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=120

MAX_AUTO_REVISIONS=1
RUN_BUDGET_USD=5.00
MAX_UPLOAD_MB=50
STORAGE_BACKEND=local          # local | s3
STORAGE_PATH=/data/files
S3_BUCKET=
S3_ENDPOINT=
TRACING_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Host ports for docker compose (change if 5432/8000/3000 are taken)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
